preselected_autotype_output() {
    printf "%s|%s" "${FAKE_PARAMS[0]}" "${FAKE_PARAMS[2]}"
}

test_preselect_autotype_without_menus() {
    fake get_config_file echo ""
    fake find fake_find "${HOME}/.password-store" "work/github"
    fake _wofi echo "UNEXPECTED MENU"
    fake _pass <<EOF
paSSw0rd
username: user
EOF
    fake output_autotype preselected_autotype_output
    WOFI_PASS_AUTOTYPE_1=":password"
    WOFI_PASS_AUTOTYPE_1_ALIAS="login"
    local output
    output="$(main -t --autotype=login --preselect=github)"
    assert_equals "work/github|:password" "${output}"
}

