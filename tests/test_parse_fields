test_parse_fields_autotype_menu_custom_zero() {
    fake _pass <<EOF
paSSw0rd
username: user
EOF
    FLAG_TYPE=1
    WOFI_PASS_AUTOTYPE=":password"
    local expected_autotype=0
    local index
    for index in {1..9}; do
        printf -v "WOFI_PASS_AUTOTYPE_${index}" "%s" "${WOFI_PASS_AUTOTYPE}"
    done
    verify_parsed_fields 0 "autotype default" "password" "username"

    WOFI_PASS_AUTOTYPE_1=":username"
    WOFI_PASS_AUTOTYPE_9=":password"
    verify_parsed_fields 0 "autotype default" "autotype 1" "password" "username"
}

test_parse_fields_autotype_menu_all_numbered_different() {
    fake _pass <<EOF
paSSw0rd
username: user
EOF
    FLAG_TYPE=1
    WOFI_PASS_AUTOTYPE=":password"
    local expected_autotype=0
    local index
    for index in {1..9}; do
        printf -v "WOFI_PASS_AUTOTYPE_${index}" "%s" ":username"
    done
    verify_parsed_fields 0 "autotype default" "autotype 1" "autotype 2" "autotype 3" \
        "autotype 4" "autotype 5" "autotype 6" "autotype 7" "autotype 8" \
        "autotype 9" "password" "username"
}

test_parse_fields_ignore() {
    fake _pass <<EOF
paSSw0rd
${PASS_FIELD_USERNAME}: username@e-mail.com
ignore this line
url: http://example.com
ignore this line either
this line: is expected
EOF

    FLAG_AUTOTYPE=0
    local expected_autotype=0
    local expected_array=("password" "${PASS_FIELD_USERNAME}" "url" "this line")
    verify_parsed_fields ${expected_autotype} "${expected_array[@]}"

    FLAG_FILEISUSER=1
    verify_parsed_fields ${expected_autotype} "${expected_array[@]}"
}

